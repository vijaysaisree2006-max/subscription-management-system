# ==============================================================================
# Supabase Configuration for Odoo Subscription Management System
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy your "Project URL" and the "anon public" API key below.
# 4. Copy this file to '.env' and fill in the values:
#       cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# NEVER expose your 'service_role' key in the frontend.
# Only use the 'anon' public key. Row-Level Security (RLS) protects data access.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

